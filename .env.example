# Variable names only. Put real values in Vercel (Settings > Environment Variables)
# or in an untracked .env.local. Never commit keys to this file.

# Postgres (Supabase > Connect). App: transaction pooler (port 6543).
DATABASE_URL=
# Migrations: session pooler (port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that become super-admins on first sign-in
SUPER_ADMIN_EMAILS=

# Public URL of this app (used for Kapso redirects and webhooks)
APP_URL=http://localhost:3000

# Kapso. The two webhook secrets are random strings you choose
# (for example `openssl rand -hex 32`); Ikarus registers them with Kapso itself.
KAPSO_API_KEY=
KAPSO_PROJECT_WEBHOOK_SECRET=
KAPSO_MESSAGE_WEBHOOK_SECRET=

# The booking agent: any OpenAI-compatible Chat Completions endpoint whose
# model supports tool calls (OpenAI, OpenRouter, Groq, Together, vLLM, Ollama...).
# Base URL up to /v1, without /chat/completions. Defaults to OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Bank account for clinics' monthly transfers, shown on their invoices (several lines are fine)
BILLING_BANK_DETAILS=

# Inngest: set INNGEST_DEV=1 locally (with `npm run inngest:dev`); keys in production
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App-level encryption of patient data (notes, DUI, allergies, intake answers,
# WhatsApp messages). Comma-separated version:key pairs; the highest version
# encrypts, older ones only decrypt. Make a key with `openssl rand -base64 32`.
# Required: without it nothing patient-related can be read or written.
DATA_ENCRYPTION_KEYS=
